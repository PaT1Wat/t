# Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Google Sheets Configuration
# Option 1: JSON string of service account credentials
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option 2: Path to service account JSON file
GOOGLE_CREDENTIALS_FILE=./credentials.json
# Spreadsheet ID (get from Google Sheets URL)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Firebase Configuration
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Or path to Firebase credentials file
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

